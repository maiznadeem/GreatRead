# Files not uploaded by `gcloud run deploy --source` (see deploy.sh). Secrets never go into the image:
# runtime config comes from Cloud Run env vars (.cloudrun-env.yaml) and GCS auth from the service account.
.gcloudignore
.git
.gitignore
node_modules/
.env
.env.*
.cloudrun-env.yaml
service-account.json
controllers/service-account.json
